{
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 5, "patch": 0 },
  "$comment": [
    "One preset per system, compiler and build type, named <system>-<compiler>-<type>; each builds every target but",
    "those named otherwise: fuzz the fuzzers only (netcodec's, the sound decoders'), server the dedicated server and the game module.",
    "cmake --workflow --preset <name> configures, builds and tests. MSVC from the x64 environment of Visual Studio,",
    "clang on Windows from llvm-mingw in the PATH, GCC 15 and Clang 23 on Linux."
  ],
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}"
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "modernjk_PORTABLE": "ON" }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "windows",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "mingw-clang",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "linux",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc-15", "CMAKE_CXX_COMPILER": "g++-15" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "linux",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-23", "CMAKE_CXX_COMPILER": "clang++-23" }
    },
    { "name": "release", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "lto",
      "hidden": true,
      "description": "Link-time optimization, in the Release presets of the compilers whose code it makes faster",
      "cacheVariables": { "modernjk_ENABLE_IPO": "ON" }
    },
    { "name": "debug", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    {
      "name": "fuzzers-only",
      "hidden": true,
      "cacheVariables": {
        "modernjk_BUILD_MP_CLIENT": "OFF", "modernjk_BUILD_MP_SERVER": "OFF", "modernjk_BUILD_MP_GAME": "OFF",
        "modernjk_BUILD_SP": "OFF", "modernjk_BUILD_JK2": "OFF", "modernjk_BUILD_ASSETS_PK3": "OFF"
      }
    },
    {
      "name": "asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "modernjk_ENABLE_SANITIZER_ADDRESS": "ON", "modernjk_ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },

    { "name": "windows-msvc-release", "displayName": "MSVC x64 Release", "inherits": [ "msvc", "release", "lto" ] },
    { "name": "windows-msvc-debug", "displayName": "MSVC x64 Debug", "inherits": [ "msvc", "debug" ] },
    {
      "name": "windows-msvc-asan",
      "displayName": "MSVC x64 with AddressSanitizer",
      "inherits": [ "msvc", "asan" ],
      "cacheVariables": { "modernjk_ENABLE_SANITIZER_UNDEFINED": "OFF" }
    },
    { "name": "windows-clang-release", "displayName": "clang (llvm-mingw) x64 Release", "inherits": [ "mingw-clang", "release", "lto" ] },
    { "name": "windows-clang-debug", "displayName": "clang (llvm-mingw) x64 Debug", "inherits": [ "mingw-clang", "debug" ] },
    {
      "name": "windows-clang-asan",
      "displayName": "clang (llvm-mingw) x64 with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": [ "mingw-clang", "asan" ]
    },
    {
      "name": "windows-clang-fuzz",
      "displayName": "clang (llvm-mingw) x64, the libFuzzer targets (netcodec's, the sound decoders') with the sanitizers",
      "inherits": [ "mingw-clang", "asan", "fuzzers-only" ],
      "cacheVariables": {
        "modernjk_BUILD_FUZZ_TESTS": "ON", "BUILD_TESTING": "OFF", "modernjk_BUILD_BENCHMARKS": "OFF",
        "modernjk_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "windows-clang-tidy",
      "displayName": "clang (llvm-mingw) x64 Release with clang-tidy (reports; netcodec's findings are errors)",
      "inherits": [ "mingw-clang", "release" ],
      "cacheVariables": { "modernjk_ENABLE_CLANG_TIDY": "ON" }
    },
    {
      "name": "windows-clang-cppcheck",
      "displayName": "clang (llvm-mingw) x64 Release with cppcheck (reports)",
      "inherits": [ "mingw-clang", "release" ],
      "cacheVariables": { "modernjk_ENABLE_CPPCHECK": "ON" }
    },
    { "name": "linux-gcc-release", "displayName": "GCC 15 x64 Release", "inherits": [ "gcc", "release", "lto" ] },
    { "name": "linux-gcc-debug", "displayName": "GCC 15 x64 Debug", "inherits": [ "gcc", "debug" ] },
    {
      "name": "linux-gcc-asan",
      "displayName": "GCC 15 x64 with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": [ "gcc", "asan" ]
    },
    {
      "name": "linux-gcc-server",
      "displayName": "GCC 15 x64 Release, the dedicated server and the game module (the servers' build)",
      "inherits": [ "gcc", "release", "lto" ],
      "cacheVariables": {
        "modernjk_BUILD_MP_CLIENT": "OFF", "modernjk_BUILD_SP": "OFF", "modernjk_BUILD_JK2": "OFF",
        "modernjk_BUILD_ASSETS_PK3": "OFF", "BUILD_TESTING": "OFF", "modernjk_BUILD_BENCHMARKS": "OFF",
        "modernjk_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "linux-gcc-debug-lto",
      "displayName": "GCC 15 x64 Debug with link-time optimization, a check: the types and declarations across files of the code only Debug compiles",
      "inherits": [ "gcc", "debug" ],
      "cacheVariables": { "CMAKE_INTERPROCEDURAL_OPTIMIZATION_DEBUG": "ON" }
    },
    { "name": "linux-clang-release", "displayName": "Clang 23 x64 Release", "inherits": [ "clang", "release", "lto" ] },
    {
      "name": "linux-clang-asan",
      "displayName": "Clang 23 x64 with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": [ "clang", "asan" ]
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-asan", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release" },
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
    { "name": "windows-clang-asan", "configurePreset": "windows-clang-asan" },
    { "name": "windows-clang-fuzz", "configurePreset": "windows-clang-fuzz" },
    { "name": "windows-clang-tidy", "configurePreset": "windows-clang-tidy" },
    { "name": "windows-clang-cppcheck", "configurePreset": "windows-clang-cppcheck" },
    { "name": "linux-gcc-release", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-asan", "configurePreset": "linux-gcc-asan" },
    { "name": "linux-gcc-server", "configurePreset": "linux-gcc-server" },
    { "name": "linux-gcc-debug-lto", "configurePreset": "linux-gcc-debug-lto" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan", "configurePreset": "linux-clang-asan" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "verbosity": "verbose" },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    { "name": "windows-msvc-release", "inherits": "test-base", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-debug", "inherits": "test-base", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-asan", "inherits": "test-base", "configurePreset": "windows-msvc-asan" },
    { "name": "windows-clang-release", "inherits": "test-base", "configurePreset": "windows-clang-release" },
    { "name": "windows-clang-debug", "inherits": "test-base", "configurePreset": "windows-clang-debug" },
    { "name": "windows-clang-asan", "inherits": "test-base", "configurePreset": "windows-clang-asan" },
    { "name": "linux-gcc-release", "inherits": "test-base", "configurePreset": "linux-gcc-release" },
    { "name": "linux-gcc-debug", "inherits": "test-base", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-asan", "inherits": "test-base", "configurePreset": "linux-gcc-asan" },
    { "name": "linux-clang-release", "inherits": "test-base", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan", "inherits": "test-base", "configurePreset": "linux-clang-asan" }
  ],
  "workflowPresets": [
    { "name": "windows-msvc-release", "steps": [ { "type": "configure", "name": "windows-msvc-release" }, { "type": "build", "name": "windows-msvc-release" }, { "type": "test", "name": "windows-msvc-release" } ] },
    { "name": "windows-msvc-debug", "steps": [ { "type": "configure", "name": "windows-msvc-debug" }, { "type": "build", "name": "windows-msvc-debug" }, { "type": "test", "name": "windows-msvc-debug" } ] },
    { "name": "windows-msvc-asan", "steps": [ { "type": "configure", "name": "windows-msvc-asan" }, { "type": "build", "name": "windows-msvc-asan" }, { "type": "test", "name": "windows-msvc-asan" } ] },
    { "name": "windows-clang-release", "steps": [ { "type": "configure", "name": "windows-clang-release" }, { "type": "build", "name": "windows-clang-release" }, { "type": "test", "name": "windows-clang-release" } ] },
    { "name": "windows-clang-debug", "steps": [ { "type": "configure", "name": "windows-clang-debug" }, { "type": "build", "name": "windows-clang-debug" }, { "type": "test", "name": "windows-clang-debug" } ] },
    { "name": "windows-clang-asan", "steps": [ { "type": "configure", "name": "windows-clang-asan" }, { "type": "build", "name": "windows-clang-asan" }, { "type": "test", "name": "windows-clang-asan" } ] },
    { "name": "windows-clang-fuzz", "steps": [ { "type": "configure", "name": "windows-clang-fuzz" }, { "type": "build", "name": "windows-clang-fuzz" } ] },
    { "name": "windows-clang-tidy", "steps": [ { "type": "configure", "name": "windows-clang-tidy" }, { "type": "build", "name": "windows-clang-tidy" } ] },
    { "name": "windows-clang-cppcheck", "steps": [ { "type": "configure", "name": "windows-clang-cppcheck" }, { "type": "build", "name": "windows-clang-cppcheck" } ] },
    { "name": "linux-gcc-release", "steps": [ { "type": "configure", "name": "linux-gcc-release" }, { "type": "build", "name": "linux-gcc-release" }, { "type": "test", "name": "linux-gcc-release" } ] },
    { "name": "linux-gcc-debug", "steps": [ { "type": "configure", "name": "linux-gcc-debug" }, { "type": "build", "name": "linux-gcc-debug" }, { "type": "test", "name": "linux-gcc-debug" } ] },
    { "name": "linux-gcc-asan", "steps": [ { "type": "configure", "name": "linux-gcc-asan" }, { "type": "build", "name": "linux-gcc-asan" }, { "type": "test", "name": "linux-gcc-asan" } ] },
    { "name": "linux-gcc-server", "steps": [ { "type": "configure", "name": "linux-gcc-server" }, { "type": "build", "name": "linux-gcc-server" } ] },
    { "name": "linux-clang-release", "steps": [ { "type": "configure", "name": "linux-clang-release" }, { "type": "build", "name": "linux-clang-release" }, { "type": "test", "name": "linux-clang-release" } ] },
    { "name": "linux-clang-asan", "steps": [ { "type": "configure", "name": "linux-clang-asan" }, { "type": "build", "name": "linux-clang-asan" }, { "type": "test", "name": "linux-clang-asan" } ] }
  ]
}
