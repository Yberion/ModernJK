+// plan step 20 part 9 (temporary): a scenario slot's number, or -1
+static int G_ShotSlot(const gentity_t* ent)
+{
+    for (int n = 0; n < scn.numClients && n < 3; n++) {
+        if (ent && scn.client[n] == ent->s.number) {
+            return n;
+        }
+    }
+    return -1;
+}
+
+static bool G_ShotCounting(void)
+{
+    return scn.type != scenarioType_t::SCN_NONE && !scn.done && scn.repStart && scn.rep >= 1;
+}
+
+// a point of a slot's model: its head (the bolt *head_eyes) or its chest (thoracic), false without them
+static bool G_ShotPoint(int slot, int at, vec3_t point)
+{
+    extern void G_GetBoltPosition(gentity_t * self, int boltIndex, vec3_t pos, int modelIndex);
+    gentity_t* ent = &g_entities[scn.client[slot]];
+    const int bolt = (ent->inuse && ent->client) ? (at ? ent->client->renderInfo.torsoBolt : ent->client->renderInfo.headBolt) : -1;
+
+    if (!ent->ghoul2 || bolt < 0) {
+        return false;
+    }
+    G_GetBoltPosition(ent, bolt, point, 0);
+    return true;
+}
+
+// the attacker's gun's *flash bolt: the weapon's world model put on the player's bolt 0, the right hand
+// (SetupGameGhoul2Model), as cgame does for the model it draws (CG_InitG2Weapons), as the player's model 4
+static bool G_ShotFlash(gentity_t* ent, vec3_t flash)
+{
+    mdxaBone_t m;
+
+    if (!shotScn.gun || shotScn.gunWeapon != ent->client->ps.weapon) {
+        const gitem_t* item = BG_FindItemForWeapon(ent->client->ps.weapon);
+
+        shotScn.gun = nullptr;
+        shotScn.flashBolt = -1;
+        shotScn.gunWeapon = ent->client->ps.weapon;
+        if (!item || !item->world_model[0]) {
+            return false;
+        }
+        trap->G2API_InitGhoul2Model(&shotScn.gun, item->world_model[0], 0, 0, 0, 0, 0);
+        if (!shotScn.gun) {
+            return false;
+        }
+        trap->G2API_SetBoltInfo(shotScn.gun, 0, 0);
+        trap->G2API_CopySpecificGhoul2Model(shotScn.gun, 0, ent->ghoul2, 4);
+        shotScn.flashBolt = trap->G2API_AddBolt(ent->ghoul2, 4, "*flash");
+    }
+    if (shotScn.flashBolt < 0) {
+        return false;
+    }
+    // posed as the server posed the model (WP_SaberPositionUpdate)
+    trap->G2API_GetBoltMatrix(ent->ghoul2, 4, shotScn.flashBolt, &m, ent->client->renderInfo.modelAngles, ent->client->ps.origin, level.time, nullptr,
+                              ent->modelScale);
+    BG_GiveMeVectorFromMatrix(&m, orientations_t::ORIGIN, flash);
+    return true;
+}
+
+// a shot's start and direction against the view of who fires it (forward, right, up from the eyes; the direction's
+// yaw and pitch against the view's), and how far its line passes from the target's head, chest and eye level (the
+// point the NPCs and the bots aim at), in the shot's right and up, with the distance along it
+void G_ScenarioShotTrace(gentity_t* owner, const vec3_t start, const vec3_t dir)
+{
+    gentity_t* viewer = owner;
+    const gentity_t* targ;
+    vec3_t eyes, fwd, right, up, d, ang, shotRight, shotUp, pts[3];
+    bool have[3];
+    char line[1024];
+    int slot;
+
+    if (!G_ShotCounting() || !owner) {
+        return;
+    }
+    if (!owner->client && owner->activator && owner->activator->client) {
+        viewer = owner->activator; // the emplaced gun's user
+    }
+    else if (owner->client && owner->client->NPC_class == class_t::CLASS_VEHICLE && owner->m_pVehicle && owner->m_pVehicle->m_pPilot) {
+        viewer = (gentity_t*)owner->m_pVehicle->m_pPilot;
+    }
+    slot = G_ShotSlot(viewer);
+    vectoangles(dir, ang);
+    AngleVectors(ang, nullptr, shotRight, shotUp);
+    if (viewer->client) {
+        VectorCopy(viewer->client->ps.origin, eyes);
+        eyes[2] += viewer->client->ps.viewheight;
+        AngleVectors(viewer->client->ps.viewangles, fwd, right, up);
+        VectorSubtract(start, eyes, d);
+        Com_sprintf(line, sizeof(line), "DBG shot rep%d t%d s%d slot%d w%d start f%.1f r%.1f u%.1f dir yaw%+.2f pitch%+.2f", scn.rep, level.time - scn.repStart,
+                    viewer->s.number, slot, to_underlying(viewer->client->ps.weapon), DotProduct(d, fwd), DotProduct(d, right), DotProduct(d, up),
+                    AngleSubtract(ang[YAW], viewer->client->ps.viewangles[YAW]), AngleSubtract(ang[PITCH], viewer->client->ps.viewangles[PITCH]));
+    }
+    else {
+        Com_sprintf(line, sizeof(line), "DBG shot rep%d t%d s%d slot%d noview start %.1f %.1f %.1f", scn.rep, level.time - scn.repStart, viewer->s.number, slot,
+                    start[0], start[1], start[2]);
+    }
+    targ = &g_entities[scn.client[(slot == 1) ? 0 : 1]];
+    if (targ->inuse && targ->client) {
+        static const char* names[3] = {"head", "chest", "eyelevel"};
+
+        have[0] = G_ShotPoint((slot == 1) ? 0 : 1, 0, pts[0]);
+        have[1] = G_ShotPoint((slot == 1) ? 0 : 1, 1, pts[1]);
+        VectorCopy(targ->client->ps.origin, pts[2]);
+        pts[2][2] += targ->client->ps.viewheight;
+        have[2] = true;
+        for (int k = 0; k < 3; k++) {
+            vec3_t w, miss;
+            float t;
+
+            if (!have[k]) {
+                continue;
+            }
+            VectorSubtract(pts[k], start, w);
+            t = DotProduct(w, dir);
+            VectorMA(start, t, dir, miss);
+            VectorSubtract(miss, pts[k], miss);
+            Q_strcat(line, sizeof(line), va(" | %s r%+.1f u%+.1f at%.0f", names[k], DotProduct(miss, shotRight), DotProduct(miss, shotUp), t));
+        }
+    }
+    if (shotScn.flash && slot == 0 && viewer == owner && viewer->client) {
+        vec3_t flash;
+
+        if (G_ShotFlash(viewer, flash)) {
+            VectorSubtract(flash, eyes, d);
+            Q_strcat(line, sizeof(line), va(" | flash f%.1f r%.1f u%.1f", DotProduct(d, fwd), DotProduct(d, right), DotProduct(d, up)));
+        }
+    }
+    trap->Print("%s\n", line);
+}
