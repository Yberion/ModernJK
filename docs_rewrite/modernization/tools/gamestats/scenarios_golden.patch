+			scnStats.airborne[n], scnStats.knockedDown[n], scnStats.mindTricked[n], scnStats.saberLocked[n], scnStats.path[n],
+			scnStats.end[n][0], scnStats.end[n][1], scnStats.end[n][2] ) );
