# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# The C and C++ code, laid out by clang-format (.clang-format)
[*.{c,cpp,h,hpp,inl,inc}]
indent_style = space
indent_size = 4

[*.yml]
indent_style = space
indent_size = 2

[*.{txt,md}]
charset = utf-8
