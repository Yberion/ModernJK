// ModernJK's texts of the menus, beside the game's (strings/<Language>/MENUS.str): the reverb's setting (s_reverb) the mute without the focus (s_muteWhenUnfocused), the sound device (s_device), the display's rows (r_displayState, r_screen, the resolution and the refresh rate) and the adaptive vertical sync (r_swapInterval -1).
VERSION             "1"
CONFIG              "W:\bin\stringed.cfg"
FILENOTES           ""

REFERENCE           REVERB
LANG_ENGLISH        "Reverb:"

REFERENCE           REVERB_DESC
LANG_ENGLISH        "Toggle the reverb of the rooms and places."

REFERENCE           MUTE_UNFOCUSED
LANG_ENGLISH        "Mute when unfocused:"

REFERENCE           MUTE_UNFOCUSED_DESC
LANG_ENGLISH        "Mute the sound while the game's window is not in front."

REFERENCE           SOUND_DEVICE
LANG_ENGLISH        "Sound device:"

REFERENCE           SOUND_DEVICE_DESC
LANG_ENGLISH        "The output the sound plays on: the system's default, or one of its outputs."

REFERENCE           SOUND_DEVICE_DEFAULT
LANG_ENGLISH        "Default"

REFERENCE           DISPLAY_STATE
LANG_ENGLISH        "Display:"

REFERENCE           DISPLAY_STATE_DESC
LANG_ENGLISH        "Show the game in a window, in borderless fullscreen (an instant alt-tab) or in exclusive fullscreen (one of the screen's modes)."

REFERENCE           DISPLAY_WINDOW
LANG_ENGLISH        "Window"

REFERENCE           DISPLAY_BORDERLESS
LANG_ENGLISH        "Borderless"

REFERENCE           DISPLAY_EXCLUSIVE
LANG_ENGLISH        "Exclusive"

REFERENCE           DISPLAY_SCREEN
LANG_ENGLISH        "Screen:"

REFERENCE           DISPLAY_SCREEN_DESC
LANG_ENGLISH        "The screen the game is shown on."

REFERENCE           DISPLAY_RESOLUTION
LANG_ENGLISH        "Resolution:"

REFERENCE           DISPLAY_RESOLUTION_DESC
LANG_ENGLISH        "The window's size, or the screen's mode in exclusive fullscreen; borderless fullscreen keeps the desktop's."

REFERENCE           DISPLAY_REFRESH
LANG_ENGLISH        "Refresh rate:"

REFERENCE           DISPLAY_REFRESH_DESC
LANG_ENGLISH        "The screen's refresh rate in exclusive fullscreen; a window and borderless fullscreen keep the desktop's."

REFERENCE           DISPLAY_DESKTOP
LANG_ENGLISH        "Desktop"

REFERENCE           VSYNC_ADAPTIVE
LANG_ENGLISH        "Adaptive"


ENDMARKER
