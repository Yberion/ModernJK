// ModernJK's texts of the menus, beside the game's (strings/<Language>/MENUS.str): the reverb's setting (s_reverb) and the mute without the focus (s_muteWhenUnfocused).
VERSION             "1"
CONFIG              "W:\bin\stringed.cfg"
FILENOTES           ""

REFERENCE           REVERB
LANG_ENGLISH        "Reverb:"
LANG_FRENCH         "Réverbération :"

REFERENCE           REVERB_DESC
LANG_ENGLISH        "Toggle the reverb of the rooms and places."
LANG_FRENCH         "Activer/désactiver la réverbération des salles et des lieux"

REFERENCE           MUTE_UNFOCUSED
LANG_ENGLISH        "Mute when unfocused:"
LANG_FRENCH         "Couper le son sans le focus :"

REFERENCE           MUTE_UNFOCUSED_DESC
LANG_ENGLISH        "Mute the sound while the game's window is not in front."
LANG_FRENCH         "Couper le son quand la fenêtre du jeu n'est pas au premier plan"


ENDMARKER
